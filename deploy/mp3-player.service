[Unit]
Description=MP3 Web Player
After=network.target

[Service]
Type=simple
User=your-user
WorkingDirectory=/home/your-user/Code/mp3-player
ExecStart=/usr/bin/python3 -u /home/your-user/Code/mp3-player/server.py /home/your-user/Music --port 8080
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
